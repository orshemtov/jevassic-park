# Optional server-only credential. Vercel production uses project OIDC instead.
# AI_GATEWAY_API_KEY=your-key
JEV_MODE=code

# Localhost defaults to admin; Vercel defaults to spectator.
# Keep 0 on public deployments. This is configuration, not authentication.
# ADMIN_MODE=0

SPECTATOR_POPULATION=5000
WATCH_DETAILED_GUESTS=100
DECISION_INTERVAL_MS=5000
WATCH_DAILY_BUDGET=5

# Also set the AI Gateway project budget to $4.95/day; resets at midnight UTC.
# Connect free Upstash Redis in production, with automatic paid upgrades disabled.
# The integration supplies these server-only values:
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your-token
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are also supported.
